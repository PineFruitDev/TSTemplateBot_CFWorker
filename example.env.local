# Local Environment Variables
# This file is for LOCAL development only

# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_PUBLIC_KEY=your_public_key_here

# Optional: Developer IDs (comma-separated)
DEVELOPER_IDS=your_user_id_here

# Environment
NODE_ENV=development

# Cloudflare Configuration (OPTIONAL - only needed for deployment, not local dev)
# These are NOT required for `npm run local` (which uses --local flag)
# Only needed if you want to deploy or use `npm run dev` (without --local)
# CLOUDFLARE_API_TOKEN=your_api_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id

